<%# トップページ %>
<!-- bg-tabi-surface : 背景が#FFFFFF-->
<%# flex (デフォルトで横並び)/中央寄せ(justify-center)/ボタン間の隙間(space-x-6)  %>
<div class="p-10 flex justify-center space-x-6 bg-tabi-surface">
  
  <%= link_to new_user_path do %>
    <button type="button" class="w-[200px] h-[80px] border border-tabi-border rounded-xl bg-tabi-primary hover:bg-tabi-primaryDark text-white text-sm font-medium font-serif shadow-md transition cursor-pointer">
      新規会員登録
    </button>
  <% end %>

  <%= link_to login_path do %>
    <button type="button" class="w-[200px] h-[80px] border border-tabi-border rounded-xl bg-tabi-secondary hover:bg-tabi-primaryDark text-tabi-text-main text-sm font-medium font-serif shadow-md transition cursor-pointer">
      ログイン
    </button>
  <% end %>
</div>
