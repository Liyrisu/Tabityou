<%= form_with model: diary, class: "space-y-6" do |f| %>
  <%= render 'shared/error_messages', object: f.object %>

  <!-- 画像アップロード -->
  <div class="w-full bg-gray-100 rounded-xl overflow-hidden flex items-center justify-center min-h-[300px] max-h-[450px] relative group border border-tabi-border">
    
    <!-- 新しく選択した、または既存の画像のプレビューを表示するエリア -->
    <div id="image-preview-container" class="<%= diary.image.present? ? '' : 'hidden' %> absolute inset-0 w-full h-full bg-white z-10 flex items-center justify-center">
      <img id="image-preview" src="<%= diary.image.url if diary.image.present? %>" class="w-full h-full object-contain">
      <!-- 画像を変更したいときのヒント（ホバー時に薄くレイアウト） -->
      <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center pointer-events-none">
        <span class="text-white text-xs bg-zinc-900/80 px-3 py-1.5 rounded-full font-medium">画像を変更する</span>
      </div>
    </div>

    <!-- 初期状態のプレビュー未選択時の表示 -->
    <div id="image-placeholder" class="<%= diary.image.present? ? 'hidden' : 'flex' %> flex-col items-center gap-2 text-gray-400 py-12 pointer-events-none">
      <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
      </svg>
      <span class="text-sm font-medium">写真</span>
    </div>

    <!-- 実際のファイルフィールド -->
    <%= f.file_field :image,
        id: "diary-image-input",
        class: "absolute inset-0 w-full h-full opacity-0 cursor-pointer z-20",
        accept: 'image/*' %>
    <%= f.hidden_field :image_cache %>
  </div>

  <!-- 日付入力 -->
  <div>
    <%= f.label :date, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.date_field :date,
        class: "block w-48 rounded-lg border border-tabi-border bg-gray-50 px-4 py-2.5 text-gray-950 text-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none transition-colors" %>
  </div>

  <!-- 場所入力 -->
  <div>
    <%= f.label :location, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :location,
        placeholder: "場所を入力...",
        class: "block w-full rounded-lg border border-tabi-border bg-gray-50 px-4 py-2.5 text-gray-950 text-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none transition-colors" %>
  </div>

  <!-- コメント -->
  <div>
    <%= f.label :comment, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_area :comment,
        placeholder: "コメントを入力...",
        class: "block w-full rounded-lg border border-tabi-border bg-gray-50 px-4 py-2.5 text-gray-950 text-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none transition-colors",
        rows: "4" %>
  </div>

  <!-- 送信ボタン -->
  <div class="pt-4">
    <%= f.submit nil,
        class: "w-full py-3 text-sm font-bold text-white bg-tabi-primary hover:bg-tabi-primary-dark active:bg-zinc-900 rounded-lg shadow-sm transition-colors cursor-pointer block text-center" %>
  </div>
<% end %>

<!-- プレビュー動作用のJavaScript (変更なし) -->
<script>
  (function() {
    const initPreview = () => {
      const input = document.getElementById('diary-image-input');
      const preview = document.getElementById('image-preview');
      const container = document.getElementById('image-preview-container');
      const placeholder = document.getElementById('image-placeholder');

      if (!input) return;

      input.addEventListener('change', (e) => {
        const file = e.target.files[0];
        if (file) {
          const reader = new FileReader();
          reader.onload = (e) => {
            preview.src = e.target.result;
            container.classList.remove('hidden');
            placeholder.classList.add('hidden');
          }
          reader.readAsDataURL(file);
        }
      });
    };

    document.addEventListener('DOMContentLoaded', initPreview);
    document.addEventListener('turbo:load', initPreview);
  })();
</script>
