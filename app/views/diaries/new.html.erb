<% content_for(:title, t('.title')) %>

<div class="max-w-2xl mx-auto px-4 py-8">
  <!-- 一覧へ戻るリンク -->
  <div class="mb-4">
    <%= link_to diaries_path, class: "inline-flex items-center text-xs text-gray-500 hover:text-gray-700 border border-gray-200 bg-white px-3 py-1.5 rounded-md shadow-sm transition-colors" do %>
      <svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
      </svg>
      一覧へ戻る
    <% end %>
  </div>

  <!-- フォームコンテナ -->
  <div class="bg-white p-6 sm:p-10 rounded-2xl border border-gray-100 shadow-sm">
    <%= render 'form', diary: @diary %>
  </div>
</div>
