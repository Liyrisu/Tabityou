<%= search_form_for q, url: url do |f| %>
  <div class="flex shadow-sm rounded-lg overflow-hidden max-w-md mx-auto">
    <%= f.search_field :comment_cont, 
        class: 'block w-full px-4 py-2 text-gray-900 bg-white border border-gray-300 rounded-l-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:outline-none text-sm', 
        placeholder: t('defaults.search_word') %>
    <%= f.submit class: 'flex-shrink-0 px-6 py-2 text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 active:bg-blue-800 transition-colors duration-150 rounded-r-lg cursor-pointer' %>
  </div>
<% end %>
