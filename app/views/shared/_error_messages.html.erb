<% if object.errors.any? %>
  <%# bg-red-50（薄赤背景）、border-red-200（赤枠）、text-red-800（濃赤文字） %>
  <div id="error_explanation" class="bg-red-50 border border-red-200 text-red-800 rounded-lg p-4 my-4 shadow-sm" role="alert">
    
    <%# リストにポチ（list-disc）をつける /行間（space-y-1）を少し空ける %>
    <ul class="list-disc list-inside text-sm space-y-1 font-medium pl-1">
      <% object.errors.each do |error| %>
        <li><%= error.full_message %></li>
      <% end %>
    </ul>
    
  </div>
<% end %>
