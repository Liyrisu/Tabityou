<% flash.each do |message_type, message| %>
  <%# メッセージのタイプ（success / danger / noticeなど）によって枠や背景の色を判定 %>
  <% 
    bg_color = case message_type.to_s
               when 'success' then 'bg-green-50 border-green-200 text-green-800'
               when 'danger', 'alert', 'error' then 'bg-red-50 border-red-200 text-red-800'
               else 'bg-blue-50 border-blue-200 text-blue-800' # noticeなどのデフォルト
               end
  %>

  <div class="<%= bg_color %> border rounded-lg p-4 my-4 shadow-sm text-sm font-medium" role="alert">
    <%= message %>
  </div>
<% end %>
